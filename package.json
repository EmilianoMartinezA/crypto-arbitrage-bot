{
  "name": "crypto-arbitrage-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Bitcoin arbitrage detection and simulation bot",
  "author": "Emiliano Martinez",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:bot": "npm run dev -w apps/bot",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:bot": "npm run build -w apps/bot",
    "build:web": "npm run build -w apps/web",
    "start": "npm run start --workspaces --if-present",
    "start:bot": "npm run start -w apps/bot",
    "start:web": "npm run start -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
